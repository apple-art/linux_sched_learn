        </mxCell>
        <mxCell id="fast" value="Fast switch · 同步&#xa;cpufreq_driver_fast_switch()&#xa;→ driver->fast_switch()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="350" width="310" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="slow" value="无 Fast switch · 延迟提交&#xa;irq_work → kthread_work&#xa;→ __cpufreq_driver_target()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
