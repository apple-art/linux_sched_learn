        <mxCell id="hardware" value="平台驱动 · 硬件&#xa;P-state / OPP / CPPC&#xa;电压与时钟真正改变" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DDD6FE;gradientColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="625" width="310" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="note1" value="关键提醒　利用率不是频率百分比&#xa;它还要经过容量、频率不变性、UCLAMP、RT / DL 等处理。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;gradientColor=#FEF3C7;strokeColor=#FBBF24;fontSize=14;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=16;shadow=1;" vertex="1" parent="1">
