        <mxCell id="bridge_note" value="桥接层只负责把调度器事件送到 governor；&#xa;回调必须快速、不可睡眠。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#784212;" vertex="1" parent="1">
          <mxGeometry x="420" y="660" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="common" value="sugov_update_single_common()&#xa;① IO-wait boost　② rate limit / policy limits&#xa;③ sugov_get_util()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#ECFDF5;strokeColor=#4ADE80;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="185" width="360" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="util" value="sugov_get_util()&#xa;util = effective_cpu_util()&#xa;max_cap = arch_scale_cpu_capacity()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#ECFDF5;strokeColor=#4ADE80;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="formula" value="get_next_freq()&#xa;f_des ≈ min(f_max, 1.25 × util / max × f_max)&#xa;frequency-invariant：max_freq　否则：curr_freq" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;gradientColor=#BBF7D0;strokeColor=#22C55E;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="475" width="360" height="102" as="geometry"/>
        </mxCell>
        <mxCell id="branch" value="策略分支 · sugov_start() 选择回调&#xa;单 CPU　sugov_update_single_freq()&#xa;共享 policy　遍历 policy->cpus 取 max util&#xa;性能接口　sugov_update_single_perf() → adjust_perf()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#4ADE80;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="625" width="360" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="resolve" value="目标频率解析&#xa;cpufreq_driver_resolve_freq()&#xa;clamp policy min / max&#xa;映射到 driver 频率表 / OPP" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;gradientColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
